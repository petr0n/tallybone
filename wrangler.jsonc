{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "tallybone",
  "compatibility_date": "2026-07-27",
  "main": "./server/index.js",
  "assets": {
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"],
  },
  "durable_objects": {
    "bindings": [
      {
        "name": "GAME",
        "class_name": "GameRoom",
      },
    ],
  },
  "migrations": [
    {
      "tag": "v1",
      "new_classes": ["GameRoom"],
    },
  ],
}
